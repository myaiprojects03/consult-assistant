# Copy to .env (in this folder) and fill in. Never commit .env.
APP_ENV=development

# ---- AI model ----
# groq = free plan (used during the build). anthropic = Claude (production target).
# openai_compatible = OpenRouter, OpenAI or a local Ollama (set the LLM_* lines).
LLM_PROVIDER=groq
# console.groq.com -> API Keys (free)
GROQ_API_KEY=
# console.anthropic.com -> API Keys (needed for LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_BACKGROUND_MODEL=openai/gpt-oss-20b   # summaries: a separate model has its own per-minute limit
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b     # live chat and calls switch to it at the main model's limit
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_CHAT_MODEL=

# ---- Knowledge search ----
# local = embeddings computed on this server (no cost); none = keyword search only
EMBEDDING_PROVIDER=local
# EMBEDDING_THREADS=1        # on small hosts (512 MB) keeps memory low

# ---- Database and Redis (docker compose up -d starts both locally) ----
DATABASE_URL=postgresql://consult:consult@localhost:5432/consult
REDIS_URL=redis://localhost:6379/0

# ---- Websites allowed to call the chat API (comma-separated, no trailing slash) ----
ALLOWED_ORIGINS=http://localhost:3000
# Header with the visitor's real address, set by the host's edge (Render: cf-connecting-ip). Unset locally.
# CLIENT_IP_HEADER=

# ======================= Phase 2: integrations (each optional; see docs/SETUP.md) =======================
# Background jobs. local = run inside this server (use on your computer). qstash = for serverless hosting.
JOB_RUNNER=local
# PUBLIC_API_URL=https://your-api.example.com
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# ---- CRM: none | hubspot ----
CRM_PROVIDER=none
HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_PIPELINE=default
# HUBSPOT_DEAL_STAGE=appointmentscheduled

# ---- Calendar: local (bookings in the database only) | google ----
CALENDAR_PROVIDER=local
# ---- Email: none | gmail ----
EMAIL_PROVIDER=none
# Google Cloud > APIs & Services > Credentials > OAuth client (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in by: python -m scripts.google_auth
GOOGLE_REFRESH_TOKEN=
# The Google account's address, so emails show the firm's name as the sender
EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=Acme IT Consulting

# ---- Slack (leave the token empty to switch Slack off) ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_LEADS=#leads
SLACK_CHANNEL_HANDOVERS=#handovers
# SLACK_CHANNEL_ALERTS=#handovers

# ======================= Phase 3: client support and team assistant (see docs/SETUP.md, Jira) =======================
# Tickets: none (kept in the database only) | jira
TICKETING_PROVIDER=none
# Your Jira site, e.g. https://yourname.atlassian.net
JIRA_BASE_URL=
# The Atlassian account email the API token belongs to
JIRA_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
# JIRA_ISSUE_TYPE=Task
# New tickets are posted here (defaults to the handovers channel)
# SLACK_CHANNEL_SUPPORT=#support

# ======================= Phase 4: voice calls and text messages (see docs/SETUP.md, Twilio) =======================
# Browser voice calls (/voice) need nothing here. Phone calls need a paid (upgraded) Twilio account.
VOICE_PROVIDER=none          # none | twilio
SMS_PROVIDER=none            # none (logged) | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=         # +44..., the number callers dial; calls and SMS come from it
# PUBLIC_API_URL (above) must be this API's https address: Twilio calls it (locally: the tunnel address)
# VOICE_TTS_PROVIDER=ElevenLabs     # ElevenLabs | Google | Amazon
# VOICE_TTS_VOICE=                  # empty = the provider's default voice
